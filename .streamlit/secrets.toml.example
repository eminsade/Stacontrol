# ===========================================================================
#  Streamlit Community Cloud icin gizli degerler
#
#  Bu dosyayi DEPOYA EKLEMEYIN. Icerigini su adrese yapistirin:
#    Uygulama sayfasi > Manage app > Settings > Secrets
#
#  Kendi sunucunuzda (VPS) calisiyorsaniz bunlara gerek yok; ortam
#  degiskeni kullanin (bkz. .env.example).
# ===========================================================================

# Uretmek icin: python -c "import secrets;print(secrets.token_urlsafe(32))"
BRIDGE_INTERNAL_KEY = "buraya-uretilen-anahtar"
COOKIES_PASSWORD    = "buraya-baska-bir-anahtar"

# ONEMLI: Kopru API'si Streamlit Community Cloud uzerinde BARINAMAZ.
# Ajanin ulasabilmesi icin ayri bir yerde (VPS / Fly.io / Render) calismali
# ve buraya onun genel HTTPS adresi yazilmalidir.
BRIDGE_URL = "https://kopru.sizin-alan-adiniz.com"

# Ajan zip dosyasinin indirme adresi (GitHub Releases onerilir).
AGENT_DOWNLOAD_URL = "https://github.com/eminsade/Stacontrol/releases/latest/download/StacontrolAgent.zip"

# ---------------------------------------------------------------------------
# PYTHON SURUMU
# ---------------------------------------------------------------------------
# Streamlit Community Cloud varsayilan olarak cok yeni bir Python secebilir
# (orn. 3.14). requirements.txt pandas<3 gerektirir ve pandas 2.x'in 3.14
# icin hazir paketi (wheel) yoktur -- kurulum kaynaktan derlemeye calisip
# basarisiz olur.
#
# Uygulama sayfasinda: Manage app > Settings > Python version -> 3.12 secin.
