# ===========================================================================
#  Stacontrol - ortam degiskenleri
#  Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
#  .env dosyasini ASLA depoya eklemeyin (.gitignore'da tanimlidir).
# ===========================================================================

# --- Zorunlu sirlar --------------------------------------------------------
# Uretmek icin:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# Streamlit arka ucu ile kopru API'si arasindaki paylasilan anahtar.
# Tarayiciya asla gonderilmez.
BRIDGE_INTERNAL_KEY=

# Oturum cerezlerinin sifreleme anahtari. Degistirilirse tum kullanicilar
# bir kez cikis yapmis olur.
COOKIES_PASSWORD=

# --- Adresler --------------------------------------------------------------
# Streamlit'in kopruye ulasacagi ic adres (ayni makinede calisiyorsa localhost).
BRIDGE_URL=http://127.0.0.1:8500

# Ajanin baglanacagi genel adres. Ajan paketine bu adres gomulur.
PUBLIC_BRIDGE_URL=https://stacontrol.com/bridge

# Ajan zip dosyasinin indirme adresi (bos birakilirsa Streamlit statik servisi).
# AGENT_DOWNLOAD_URL=https://stacontrol.com/indir/StacontrolAgent.zip

# --- Veritabani ------------------------------------------------------------
# Kalici bir dizin secin; uygulama guncellemesinde silinmemeli.
STACONTROL_DB=/var/lib/stacontrol/hesaplama_sonuc.db
BRIDGE_DB=/var/lib/stacontrol/bridge_state.db

# --- Ince ayar (opsiyonel) -------------------------------------------------
# Eslestirme kodunun gecerlilik suresi (saniye)
# BRIDGE_PAIRING_TTL=600
# Ajandan bu sure haber alinmazsa cevrimdisi sayilir (saniye)
# BRIDGE_AGENT_IDLE_TIMEOUT=90
# Bir tarayici sekmesinin ajan uzerindeki ozel kullanim suresi (saniye)
# BRIDGE_LEASE_TTL=120
# bcrypt maliyeti (yuksek = daha guvenli ama daha yavas giris)
# STACONTROL_BCRYPT_ROUNDS=12

# --- Gelistirme ------------------------------------------------------------
# STACONTROL_DEV=1
# BRIDGE_DEV_MODE=1
